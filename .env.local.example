# To enable / disable self-hosting features.
SELF_HOSTED=false

# Name shown in the app (defaults to the placeholder "Kosh")
PRODUCT_NAME=Kosh

# Indian market data (AMFI/MFAPI NAVs, Yahoo Finance NSE/BSE prices, Frankfurter FX) is on by default.
# Set to true to work fully offline, for example when the sources are blocked or flaky.
# DISABLE_INDIAN_MARKET_DATA=true

# Enable Synth market data (careful, this will use your API credits)
SYNTH_API_KEY=yourapikeyhere
