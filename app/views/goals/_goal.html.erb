<%# locals: (goal:) %>

<% projection = goal.projection %>
<% required_sip = projection.required_monthly_sip %>
<% date_format = Current.family.date_format.presence || "%d-%m-%Y" %>

<%= link_to goal_path(goal), id: dom_id(goal), class: "block bg-container shadow-border-xs rounded-xl p-4 space-y-4 hover:bg-surface-hover" do %>
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <p class="text-primary font-medium truncate"><%= goal.name %></p>
      <p class="text-xs text-secondary"><%= goal.kind_label %> &middot; by <%= goal.target_date.strftime(date_format) %></p>
    </div>

    <% if projection.on_track? %>
      <span class="shrink-0 text-xs font-medium rounded-full px-2 py-0.5 bg-success/10 text-success">On track</span>
    <% else %>
      <span class="shrink-0 text-xs font-medium rounded-full px-2 py-0.5 bg-destructive/10 text-destructive">Shortfall</span>
    <% end %>
  </div>

  <div>
    <p class="text-xs text-secondary">Target (today's money)</p>
    <p class="text-2xl font-medium text-primary"><%= format_money_compact(projection.money(projection.target_today)) %></p>
  </div>

  <div class="space-y-1">
    <div class="flex justify-between text-xs text-secondary">
      <span><%= format_money_compact(goal.allocated_value) %> allocated</span>
      <span><%= number_to_percentage(projection.progress_pct, precision: 0) %></span>
    </div>
    <div class="w-full h-1.5 bg-gray-100 theme-dark:bg-gray-700 rounded-2xl" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= projection.progress_pct.round %>">
      <div class="h-full bg-success rounded-2xl" style="width: <%= projection.progress_pct.round %>%;"></div>
    </div>
  </div>

  <div class="flex justify-between text-sm">
    <span class="text-secondary">Required SIP</span>
    <span class="text-primary font-medium">
      <%= required_sip ? "#{format_money_compact(projection.money(required_sip))} / month" : "-" %>
    </span>
  </div>
<% end %>
