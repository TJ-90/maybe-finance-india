<%# locals: (goal:, date_format:) %>

<% snapshots = goal.goal_snapshots.order(:date).last(180) %>
<% change = goal.last_status_change %>

<section id="goal-status-history" class="bg-container shadow-border-xs rounded-xl p-4 space-y-3">
  <div class="flex items-center justify-between gap-2">
    <h2 class="font-medium text-primary">Status history</h2>
    <% if snapshots.any? %>
      <%= goal_status_badge(snapshots.last.status) %>
    <% end %>
  </div>

  <% if snapshots.size < 2 %>
    <p class="text-sm text-secondary">The goal is checked once a day. A progress chart shows up here after a couple of checks.</p>
  <% else %>
    <svg viewBox="0 0 300 80" class="w-full h-20 text-success" role="img" aria-label="Progress towards the target over time" preserveAspectRatio="none">
      <polyline points="<%= progress_polyline_points(snapshots) %>" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
    </svg>
    <p class="text-xs text-secondary">
      Progress from <%= snapshots.first.date.strftime(date_format) %> to <%= snapshots.last.date.strftime(date_format) %>:
      <%= number_to_percentage(snapshots.first.progress_pct, precision: 0) %> to <%= number_to_percentage(snapshots.last.progress_pct, precision: 0) %> of the target.
    </p>
  <% end %>

  <% if change %>
    <% after, before = change %>
    <p class="text-sm text-secondary" id="last-status-change">
      Last change on <%= after.date.strftime(date_format) %>: <%= before.status_label.downcase %> to <%= after.status_label.downcase %>.
    </p>
  <% elsif snapshots.any? %>
    <p class="text-sm text-secondary" id="last-status-change">Status has stayed <%= snapshots.last.status_label.downcase %> since <%= snapshots.first.date.strftime(date_format) %>.</p>
  <% end %>
</section>
