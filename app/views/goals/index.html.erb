<%= content_for :page_title, "Goals" %>

<div class="space-y-4 pb-20">
  <header class="flex items-center justify-between gap-2">
    <h1 class="text-primary text-xl font-medium">Goals</h1>

    <div class="flex items-center gap-2">
      <%= render DS::Link.new(
        text: "Emergency fund",
        variant: "outline",
        href: new_goal_path(kind: "emergency_fund", use_average_expenses: 1),
        frame: :modal
      ) %>
      <%= render DS::Link.new(
        text: "New goal",
        variant: "primary",
        icon: "plus",
        href: new_goal_path,
        frame: :modal
      ) %>
    </div>
  </header>

  <p class="text-sm text-secondary">
    Plan first, allocate later. Set a target in today's money and see the monthly SIP needed to reach it after inflation.
    Projections are estimates, not investment advice.
  </p>

  <% if @goals.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
      <%= render partial: "goals/goal", collection: @goals, as: :goal %>
    </div>
  <% else %>
    <div class="bg-container shadow-border-xs rounded-xl flex justify-center items-center py-20">
      <div class="text-center flex flex-col items-center max-w-[300px] space-y-2">
        <p class="text-primary font-medium text-sm">No goals yet</p>
        <p class="text-secondary text-sm">Start with retirement, a child's education, a home or an emergency fund.</p>

        <%= render DS::Link.new(
          text: "New goal",
          icon: "plus",
          variant: "primary",
          href: new_goal_path,
          frame: :modal
        ) %>
      </div>
    </div>
  <% end %>
</div>
