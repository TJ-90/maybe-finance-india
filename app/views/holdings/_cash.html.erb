<%# locals: (account:) %>

<% currency = Money::Currency.new(account.currency) %>
<% cash_weight = account.balance.zero? ? 0 : account.cash_balance / account.balance * 100 %>

<div class="<%= holdings_grid_classes("text-primary text-sm font-medium px-3 py-4") %>">
  <div class="flex items-center gap-3 min-w-0">
    <%= render DS::FilledIcon.new(
      variant: :text,
      text: currency.symbol,
      rounded: true,
      size: "lg"
    ) %>

    <div class="space-y-0.5">
      <%= tag.p t(".brokerage_cash"), class: "text-primary" %>
      <%= tag.p "#{account.currency} · #{number_to_percentage(cash_weight, precision: 1)} of account", class: "text-secondary text-xs" %>
    </div>
  </div>

  <div class="text-right">
    <%= tag.p format_money account.cash_balance_money %>
  </div>
</div>
