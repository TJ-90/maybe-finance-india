<%= turbo_frame_tag dom_id(@account, "holdings") do %>
  <div class="bg-container space-y-4 p-5 rounded-xl shadow-border-xs">
    <div class="flex items-center justify-between">
      <%= tag.h2 t(".holdings"), class: "font-medium text-lg" %>
      <%= link_to new_trade_path(account_id: @account.id),
                  id: dom_id(@account, "new_trade"),
                  data: { turbo_frame: :modal },
                  class: "flex gap-1 font-medium items-center bg-gray-50 text-primary p-2 rounded-lg" do %>
        <span class="text-primary">
          <%= icon("plus", color: "current") %>
        </span>
        <%= tag.span t(".new_holding"), class: "text-sm" %>
      <% end %>
    </div>

    <div class="bg-container-inset rounded-xl p-1">
      <div class="overflow-x-auto">
      <div class="<%= holdings_grid_classes("uppercase text-xs font-medium text-secondary px-4 py-2") %>">
        <%= tag.p t(".name") %>
        <%= tag.p t(".weight"), class: "justify-self-end" %>
        <%= tag.p t(".average_cost"), class: "justify-self-end" %>
        <%= tag.p t(".holdings"), class: "justify-self-end" %>
        <%= tag.p t(".return"), class: "justify-self-end" %>
        <%= tag.p "XIRR / 1D / CAGR", class: "justify-self-end" %>
      </div>

      <div class="bg-container rounded-lg shadow-border-xs min-w-[52rem]">
        <% unless @account.holdings_only? %>
          <%= render "holdings/cash", account: @account %>
          <%= render "shared/ruler" %>
        <% end %>

        <% holdings = @account.current_holdings_with_returns %>
        <% if holdings.any? %>
          <%= render partial: "holdings/holding", collection: holdings, spacer_template: "shared/ruler" %>
        <% end %>
      </div>
      </div>

      <p class="text-xs text-secondary px-4 py-2" data-testid="holdings-prices-as-of">
        <%= format_prices_as_of(@account.prices_last_updated_at) || "No prices yet" %>.
        CAGR is price based since the first purchase and shows -- until a year has passed.
      </p>
    </div>
  </div>
<% end %>
