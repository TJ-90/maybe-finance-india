<header class="flex items-center justify-between">
  <h1 class="text-primary text-xl font-medium">Insurance</h1>

  <%= render DS::Link.new(
    text: "New policy",
    variant: "primary",
    icon: "plus",
    href: new_insurance_policy_path,
    frame: :modal
  ) %>
</header>

<p class="text-sm text-secondary">
  Track cover and premium dates in one place. Policies are not accounts and are not part of your net worth.
</p>

<div class="bg-container rounded-xl shadow-border-xs p-4">
  <% if @insurance_policies.any? %>
    <div class="rounded-xl bg-container-inset space-y-1 p-1">
      <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
        <p>Policies</p>
        <span class="text-subdued">&middot;</span>
        <p><%= @insurance_policies.size %></p>
      </div>

      <div class="bg-container rounded-lg shadow-border-xs">
        <div class="overflow-hidden rounded-lg">
          <%= render partial: "insurance_policies/insurance_policy", collection: @insurance_policies, spacer_template: "shared/ruler" %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="flex justify-center items-center py-20">
      <div class="text-center flex flex-col items-center max-w-[300px]">
        <p class="text-primary mb-1 font-medium text-sm">No insurance policies yet</p>

        <%= render DS::Link.new(
          text: "New policy",
          icon: "plus",
          href: new_insurance_policy_path,
          frame: :modal
        ) %>
      </div>
    </div>
  <% end %>
</div>
