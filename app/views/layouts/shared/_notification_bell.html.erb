<%# Bell with the unread count, shown in the top bar. Links to the inbox. %>
<% unread = Current.user.unread_notifications_count %>

<%= link_to notifications_path,
      id: "notification-bell",
      class: "relative inline-flex items-center justify-center w-9 h-9 rounded-lg hover:bg-surface-hover",
      aria: { label: unread.positive? ? "Notifications, #{unread} unread" : "Notifications" } do %>
  <%= icon("bell") %>
  <% if unread.positive? %>
    <span class="absolute top-0.5 right-0.5 min-w-4 h-4 px-1 rounded-full bg-destructive text-white text-[10px] leading-4 font-medium text-center">
      <%= unread > 99 ? "99+" : unread %>
    </span>
  <% end %>
<% end %>
