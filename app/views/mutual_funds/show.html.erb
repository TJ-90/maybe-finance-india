<%= content_for :page_title, @scheme.name %>

<div class="space-y-4 pb-20">
  <header class="space-y-1">
    <%= link_to mutual_funds_path, class: "text-sm text-secondary hover:text-primary inline-flex items-center gap-1" do %>
      <%= icon("chevron-left", size: "sm") %> All funds
    <% end %>
    <h1 class="text-xl font-medium text-primary"><%= @scheme.name %></h1>
    <p class="text-sm text-secondary"><%= [ @scheme.amc, @scheme.category ].compact_blank.join(" · ") %></p>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <section class="lg:col-span-2 bg-container shadow-border-xs rounded-xl p-4 space-y-4">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm text-secondary">Latest NAV</p>
          <% if @scheme.latest_nav_money %>
            <p class="text-3xl font-medium text-primary"><%= format_money @scheme.latest_nav_money %></p>
            <% if @scheme.nav_date %>
              <p class="text-xs text-secondary">as of <%= l(@scheme.nav_date, format: :long) %></p>
            <% end %>
          <% else %>
            <p class="text-3xl font-medium text-secondary">--</p>
          <% end %>
        </div>

        <nav class="flex items-center gap-1" aria-label="NAV history range">
          <% MutualFundsController::NAV_RANGES.each_key do |key| %>
            <%= link_to key == "max" ? "Max" : key.upcase,
                        mutual_fund_path(@scheme, range: key),
                        class: class_names("text-xs font-medium rounded-md px-2 py-1", key == @range ? "bg-container-inset text-primary" : "text-secondary hover:text-primary") %>
          <% end %>
        </nav>
      </div>

      <% if @nav_series %>
        <div id="navHistoryChart"
             class="w-full h-64"
             data-controller="time-series-chart"
             data-time-series-chart-data-value="<%= @nav_series.to_json %>"></div>
      <% else %>
        <div class="w-full h-64 flex items-center justify-center">
          <p class="text-secondary text-sm">NAV history is not available right now.</p>
        </div>
      <% end %>
    </section>

    <aside class="space-y-4">
      <section class="bg-container shadow-border-xs rounded-xl p-4 space-y-3">
        <h2 class="font-medium text-primary">Add to an investment account</h2>

        <% if @investment_accounts.any? %>
          <ul class="space-y-2">
            <% @investment_accounts.each do |account| %>
              <li>
                <%= render DS::Link.new(
                  text: account.name,
                  icon: "plus",
                  variant: "outline",
                  href: new_trade_path(account_id: account.id, ticker: "#{@scheme.scheme_code}|#{Security::AMFI_MIC}"),
                  frame: :modal,
                  full_width: true
                ) %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-secondary">You do not have an investment account yet.</p>
          <%= render DS::Link.new(text: "Add an investment account", icon: "plus", variant: "primary", href: new_investment_path, frame: :modal) %>
        <% end %>
      </section>

      <section class="bg-container shadow-border-xs rounded-xl p-4">
        <h2 class="font-medium text-primary mb-3">Details</h2>
        <dl class="space-y-2 text-sm">
          <% [
            [ "AMFI scheme code", @scheme.scheme_code ],
            [ "ISIN (growth / payout)", @scheme.isin_growth ],
            [ "ISIN (reinvestment)", @scheme.isin_reinvestment ],
            [ "Plan", @scheme.plan&.humanize ],
            [ "Option", @scheme.option == "idcw" ? "IDCW (dividend)" : @scheme.option&.humanize ],
            [ "Scheme type", @scheme.scheme_type ],
            [ "Asset class", @scheme.asset_class&.humanize ],
            [ "Tax category (indicative)", @scheme.tax_category&.humanize ]
          ].reject { |_, value| value.blank? }.each do |label, value| %>
            <div class="flex items-center justify-between gap-4">
              <dt class="text-secondary"><%= label %></dt>
              <dd class="text-primary text-right"><%= value %></dd>
            </div>
          <% end %>
        </dl>
        <p class="text-xs text-secondary mt-3">Classification is inferred from the AMFI category. Verify it before relying on it for tax.</p>
      </section>
    </aside>
  </div>
</div>
