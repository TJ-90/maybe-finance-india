<%= content_for :previous_path, preferences_onboarding_path %>

<%= content_for :header_nav do %>
  <%= render "onboardings/onboarding_nav", user: @user %>
<% end %>

<%= content_for :cancel_action do %>
  <%= render "onboardings/logout" %>
<% end %>

<div class="grow max-w-lg w-full mx-auto bg-surface flex flex-col justify-center md:py-0 py-6 px-4 md:px-0">
  <div>
    <div class="space-y-1 mb-6">
      <h1 class="text-2xl font-medium">Who is in your household?</h1>
      <p class="text-secondary text-sm">
        Tax is worked out for each person, and an NRI is taxed differently from a resident. Add yourself, and optionally your spouse and others.
        You can change this later under Settings, Household.
      </p>
    </div>

    <% if Current.family.household_set_up? %>
      <ul class="space-y-2 mb-6" id="household-existing">
        <% Current.family.household_members.ordered.each do |member| %>
          <li class="text-sm text-primary"><%= member.name %> <span class="text-secondary">(<%= member.relationship_label %>, <%= member.residency_label %>)</span></li>
        <% end %>
      </ul>

      <%= render DS::Link.new(text: "Continue", href: goals_onboarding_path, variant: "primary", full_width: true) %>
    <% else %>
      <%= form_with url: household_onboarding_path, method: :post, data: { turbo: false }, class: "space-y-6" do %>
        <% if @error %>
          <%= render DS::Alert.new(message: @error, variant: :error) %>
        <% end %>

        <% @members.each do |row| %>
          <fieldset class="space-y-3 rounded-lg border border-primary p-4">
            <legend class="px-1 text-sm font-medium text-primary"><%= row[:index].zero? ? "You" : "Another person (optional)" %></legend>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <div class="space-y-1">
                <%= label_tag "members_#{row[:index]}_name", "Name", class: "block text-sm text-secondary" %>
                <%= text_field_tag "members[#{row[:index]}][name]", row[:name], id: "members_#{row[:index]}_name", autocomplete: "off", class: "form-field__input border border-secondary rounded-lg px-3 py-2 w-full text-sm" %>
              </div>

              <% if row[:index].zero? %>
                <%= hidden_field_tag "members[0][relationship]", "self", id: "members_0_relationship" %>
              <% else %>
                <div class="space-y-1">
                  <%= label_tag "members_#{row[:index]}_relationship", "Relationship", class: "block text-sm text-secondary" %>
                  <%= select_tag "members[#{row[:index]}][relationship]",
                                 options_for_select(HouseholdMember::RELATIONSHIPS.except("self").map { |key, label| [ label, key ] }, row[:relationship]),
                                 id: "members_#{row[:index]}_relationship", class: "form-field__input border border-secondary rounded-lg px-3 py-2 w-full text-sm" %>
                </div>
              <% end %>
            </div>

            <%# Residency is only required once a name is typed, so the optional rows can stay empty %>
            <%= render "settings/household_members/residency_field",
                       name: "members[#{row[:index]}][residency_status]", selected: row[:residency_status],
                       id_prefix: "members_#{row[:index]}_residency", required: row[:index].zero? %>
          </fieldset>
        <% end %>

        <div class="flex items-center gap-3">
          <%= render DS::Button.new(text: "Continue", type: "submit", full_width: true) %>
          <%= render DS::Link.new(text: "Skip for now", href: goals_onboarding_path, variant: "ghost") %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
