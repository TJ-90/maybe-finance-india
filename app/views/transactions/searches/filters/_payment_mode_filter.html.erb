<%# locals: (form:) %>

<div class="p-2 space-y-3">
  <% Transaction::PAYMENT_MODES.each do |mode| %>
    <div class="flex items-center gap-3" data-filter-name="<%= mode %>">
      <%= form.check_box :payment_modes,
                         {
                           multiple: true,
                           checked: @q[:payment_modes]&.include?(mode),
                           class: "checkbox checkbox--light"
                         },
                         mode,
                         nil %>
      <%= form.label :payment_modes, mode == "other" ? "Other" : mode.upcase, value: mode, class: "text-sm text-primary" %>
    </div>
  <% end %>
</div>
